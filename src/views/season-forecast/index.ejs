<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h4 mb-3">Previsión 26/27</h2>
    <form method="GET" action="/season-forecast" class="row g-3">
      <div class="col-md-3">
        <label for="season_id" class="form-label">Temporada</label>
        <select id="season_id" name="season_id" class="form-select">
          <option value="">Activa</option>
          <% if (forecast && forecast.filterOptions) { %>
            <% forecast.filterOptions.seasons.forEach((season) => { %>
              <option value="<%= season.id %>" <%= selectedFilters.seasonId === season.id ? 'selected' : '' %>><%= season.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="target_season_id" class="form-label">Temporada destino</label>
        <select id="target_season_id" name="target_season_id" class="form-select">
          <% if (forecast && forecast.filterOptions) { %>
            <% forecast.filterOptions.seasons.forEach((season) => { %>
              <option value="<%= season.id %>" <%= forecast.targetSeasonId === season.id ? 'selected' : '' %>><%= season.name %><%= season.is_active ? ' · activa' : '' %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="section" class="form-label">Sección</label>
        <select id="section" name="section" class="form-select">
          <option value="">Todas</option>
          <% if (forecast && forecast.filterOptions) { %>
            <% forecast.filterOptions.sections.forEach((section) => { %>
              <option value="<%= section.name %>" <%= selectedFilters.section === section.name ? 'selected' : '' %>><%= section.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="category" class="form-label">Categoría</label>
        <select id="category" name="category" class="form-select">
          <option value="">Todas</option>
          <% if (forecast && forecast.filterOptions) { %>
            <% forecast.filterOptions.categories.forEach((category) => { %>
              <option value="<%= category.name %>" <%= selectedFilters.category === category.name ? 'selected' : '' %>><%= category.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="team_id" class="form-label">Equipo</label>
        <select id="team_id" name="team_id" class="form-select">
          <option value="">Todos</option>
          <% if (forecast && forecast.filterOptions) { %>
            <% forecast.filterOptions.teams.forEach((team) => { %>
              <option value="<%= team.id %>" <%= selectedFilters.teamId === team.id ? 'selected' : '' %>><%= team.name %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <div class="col-12 d-flex gap-2 flex-wrap">
        <button type="submit" class="btn btn-primary">Aplicar filtros</button>
        <a href="/season-forecast" class="btn btn-outline-secondary">Limpiar</a>
      </div>
    </form>
  </div>
</div>

<% if (!forecast || !forecast.rows.length) { %>
  <div class="card shadow-sm">
    <div class="card-body text-muted">No hay jugadores con datos suficientes para generar una previsión.</div>
  </div>
<% } else { %>
  <div class="row g-4">
    <div class="col-xl-8">
      <div class="row g-4">
      <% forecast.rows.forEach((entry) => { %>
        <div class="col-lg-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
              <div>
                <h3 class="h5 mb-1"><%= entry.player.fullName %></h3>
                <div class="text-muted small"><%= entry.currentTeam %> · <%= entry.currentCategory %></div>
              </div>
              <span class="badge text-bg-<%= entry.readinessLevel === 'alta' ? 'success' : entry.readinessLevel === 'media' ? 'warning' : 'danger' %>">
                Preparación <%= entry.readinessLevel %>
              </span>
            </div>

            <div class="row g-3 small mb-3">
              <div class="col-6">
                <div class="text-muted">Siguiente categoría</div>
                <div class="fw-semibold"><%= entry.projectedNextCategory %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Media actual</div>
                <div class="fw-semibold"><%= entry.latestOverallAverage.toFixed(2) %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Tendencia</div>
                <div class="fw-semibold"><%= entry.recentTrend.label %></div>
              </div>
              <div class="col-6">
                <div class="text-muted">Recomendación</div>
                <div class="fw-semibold"><%= entry.recommendation %></div>
              </div>
            </div>

            <div class="border rounded p-3 mb-3 bg-light">
              <div class="small text-muted mb-2">Equipo propuesto <%= forecast.targetSeason ? forecast.targetSeason.name : '' %></div>
              <form method="POST" action="/season-forecast/assign" class="d-flex flex-column gap-2">
                <input type="hidden" name="playerId" value="<%= entry.player.id %>">
                <input type="hidden" name="sourceSeasonId" value="<%= forecast.resolvedSeasonId || '' %>">
                <input type="hidden" name="targetSeasonId" value="<%= forecast.targetSeasonId || '' %>">
                <input type="hidden" name="section" value="<%= selectedFilters.section || '' %>">
                <input type="hidden" name="category" value="<%= selectedFilters.category || '' %>">
                <input type="hidden" name="teamId" value="<%= selectedFilters.teamId || '' %>">
                <select name="targetTeamId" class="form-select form-select-sm" <%= forecast.targetTeams && forecast.targetTeams.length ? '' : 'disabled' %>>
                  <option value="">Seleccionar equipo destino</option>
                  <% forecast.targetTeams.forEach((team) => { %>
                    <option value="<%= team.id %>" <%= entry.assignment && entry.assignment.teamId === team.id ? 'selected' : '' %>>
                      <%= team.name %> · <%= team.category_name %> · <%= team.section_name %>
                    </option>
                  <% }) %>
                </select>
                <div class="d-flex justify-content-between align-items-center gap-2">
                  <span class="small text-muted">
                    <%= entry.assignment ? `Asignado a ${entry.assignment.teamName}` : 'Sin equipo destino guardado' %>
                  </span>
                  <button type="submit" class="btn btn-sm btn-outline-primary" <%= forecast.targetTeams && forecast.targetTeams.length ? '' : 'disabled' %>>Guardar</button>
                </div>
              </form>
            </div>

            <ul class="small text-muted ps-3 mb-3">
              <% entry.explanation.forEach((reason) => { %>
                <li><%= reason %></li>
              <% }) %>
            </ul>

            <div class="d-flex gap-2 flex-wrap">
              <a href="/season-forecast/player/<%= entry.player.id %>?season_id=<%= selectedFilters.seasonId || '' %>" class="btn btn-sm btn-primary">Ver previsión</a>
              <% if (entry.player.current_team_id) { %>
                <a href="/season-forecast/team/<%= entry.player.current_team_id %>?season_id=<%= selectedFilters.seasonId || '' %>" class="btn btn-sm btn-outline-secondary">Ver equipo</a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
      </div>
    </div>

    <div class="col-xl-4">
      <div class="card shadow-sm">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
              <h3 class="h5 mb-1">Configuración <%= forecast.targetSeason ? forecast.targetSeason.name : '' %></h3>
              <div class="small text-muted">Jugadores colocados por equipo destino</div>
            </div>
            <span class="badge text-bg-light border"><%= forecast.teamConfiguration.reduce((total, group) => total + group.internalRecommendations.length, 0) %></span>
          </div>

          <% if (!forecast.targetTeams.length) { %>
            <p class="mb-0 text-muted">No hay equipos creados para la temporada destino seleccionada.</p>
          <% } else { %>
            <div class="list-group list-group-flush">
              <% forecast.teamConfiguration.forEach((group) => { %>
                <div class="list-group-item px-0">
                  <div class="d-flex justify-content-between align-items-start gap-2">
                    <div>
                      <a class="fw-semibold text-decoration-none" href="/season-forecast/team/<%= group.team.id %>?season_id=<%= forecast.targetSeasonId || '' %>"><%= group.team.name %></a>
                      <div class="small text-muted"><%= group.team.category_name %> · <%= group.team.section_name %></div>
                    </div>
                    <span class="badge text-bg-primary"><%= group.internalRecommendations.length %></span>
                  </div>
                  <% if (group.internalRecommendations.length) { %>
                    <ul class="small mt-2 mb-0 ps-3">
                      <% group.internalRecommendations.slice(0, 6).forEach((recommendation) => { %>
                        <li><%= recommendation.player_first_name %> <%= recommendation.player_last_name %></li>
                      <% }) %>
                    </ul>
                  <% } else { %>
                    <div class="small text-muted mt-2">Sin jugadores colocados todavía.</div>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% } %>
