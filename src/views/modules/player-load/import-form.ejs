<%
  const visibleTeams = formData.visibleTeams || [];
  const selectedTeam = formData.selectedTeam || null;
  const activeSeason = formData.activeSeason || null;
  const values = formValues || {};
  const selectedSeasonId = values.season_id || (seasonView && seasonView.selectedSeasonId) || (activeSeason && activeSeason.id) || '';
  function valueFor(name, fallback) {
    return values[name] !== undefined && values[name] !== null ? values[name] : fallback;
  }
%>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
  <div>
    <div class="dashboard-kicker">Player Load</div>
    <h1 class="mb-1">Importar archivo</h1>
    <p class="text-muted mb-0">Carga minutos de competicion o asistencia a entrenamientos desde CSV, Excel o PDF y confirma antes de guardar.</p>
  </div>
  <a href="/player-load?team_id=<%= selectedTeam ? selectedTeam.id : '' %>&season_id=<%= encodeURIComponent(selectedSeasonId) %>" class="btn btn-outline-secondary">Volver</a>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <form method="POST" action="/player-load/import/preview" enctype="multipart/form-data" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label for="import_type" class="form-label">Tipo</label>
        <select id="import_type" name="import_type" class="form-select" required>
          <option value="competition" <%= valueFor('import_type', 'competition') === 'competition' ? 'selected' : '' %>>Competicion</option>
          <option value="training_attendance" <%= valueFor('import_type', 'competition') === 'training_attendance' ? 'selected' : '' %>>Entrenamientos 90'</option>
        </select>
      </div>
      <div class="col-md-4">
        <label for="team_id" class="form-label">Equipo</label>
        <select id="team_id" name="team_id" class="form-select" required>
          <% visibleTeams.forEach((team) => { %>
            <option value="<%= team.id %>" <%= selectedTeam && String(selectedTeam.id) === String(team.id) ? 'selected' : '' %>>
              <%= team.name %> · <%= team.category_name %> · <%= team.section_name %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label for="season_id" class="form-label">Temporada</label>
        <select id="season_id" name="season_id" class="form-select" required>
          <% if (seasonView && seasonView.seasons && seasonView.seasons.length) { %>
            <% seasonView.seasons.forEach((season) => { %>
              <option value="<%= season.id %>" <%= String(selectedSeasonId) === String(season.id) ? 'selected' : '' %>>
                <%= season.name %><%= season.is_active ? ' · Activa' : '' %>
              </option>
            <% }) %>
          <% } else if (activeSeason) { %>
            <option value="<%= activeSeason.id %>"><%= activeSeason.name %></option>
          <% } %>
        </select>
      </div>
      <div class="col-md-3">
        <label for="activity_date" class="form-label">Fecha / mes de referencia</label>
        <input type="date" id="activity_date" name="activity_date" class="form-control" required value="<%= valueFor('activity_date', '') %>" />
      </div>
      <div class="col-md-9">
        <label for="title" class="form-label">Titulo</label>
        <input type="text" id="title" name="title" class="form-control" required value="<%= valueFor('title', 'Importacion competitiva') %>" />
      </div>
      <div class="col-md-8">
        <label for="file" class="form-label">Archivo CSV, Excel o PDF</label>
        <input type="file" id="file" name="file" class="form-control" accept=".csv,.xlsx,.xls,.pdf" required />
        <div class="form-text">Competicion: NOMBRE y MINUTOS. Entrenamientos: informe de asistencia con Deportista y dias 1-31; cada A o R suma 90 minutos.</div>
      </div>
      <div class="col-md-4">
        <label for="notes" class="form-label">Notas</label>
        <input type="text" id="notes" name="notes" class="form-control" value="<%= valueFor('notes', '') %>" />
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-primary">Previsualizar</button>
      </div>
    </form>
  </div>
</div>

<% if (preview) { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
          <h2 class="h5 mb-1">Previsualizacion</h2>
          <p class="text-muted mb-0">Revisa emparejamientos antes de confirmar la importacion.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <span class="badge text-bg-light border"><%= preview.totalRows %> filas</span>
          <span class="badge text-bg-success"><%= preview.importableRows %> importables</span>
          <span class="badge text-bg-warning"><%= preview.errorRows %> con incidencias</span>
          <% if (preview.importType === 'training_attendance') { %>
            <span class="badge text-bg-primary"><%= preview.totalSessions %> sesiones</span>
            <span class="badge text-bg-light border"><%= preview.sessionMinutes %>' por sesion</span>
          <% } %>
        </div>
      </div>

      <div class="table-responsive mb-4">
        <table class="table table-sm align-middle">
          <thead>
            <% if (preview.importType === 'training_attendance') { %>
              <tr>
                <th>Fila</th>
                <th>Nombre archivo</th>
                <th>Jugador detectado</th>
                <th class="text-end">Dias</th>
                <th class="text-end">Minutos</th>
                <th>Estado</th>
              </tr>
            <% } else { %>
              <tr>
                <th>Fila</th>
                <th>Nombre archivo</th>
                <th>Jugador detectado</th>
                <th class="text-end">Partidos</th>
                <th class="text-end">Minutos</th>
                <th>Estado</th>
              </tr>
            <% } %>
          </thead>
          <tbody>
            <% preview.rows.forEach((row) => { %>
              <tr>
                <td><%= row.rowNumber %></td>
                <td><%= row.sourceName || '-' %></td>
                <td><%= row.matchedPlayerName || '-' %></td>
                <% if (preview.importType === 'training_attendance') { %>
                  <td class="text-end"><%= row.attendedDays %>/<%= preview.totalSessions %></td>
                <% } else { %>
                  <td class="text-end"><%= row.matches === null || row.matches === undefined ? '-' : row.matches %></td>
                <% } %>
                <td class="text-end"><%= row.minutes === null || row.minutes === undefined ? '-' : row.minutes %></td>
                <td>
                  <% if (row.importable) { %>
                    <span class="badge text-bg-success">OK</span>
                  <% } else { %>
                    <span class="badge text-bg-warning"><%= row.errors.join(' ') %></span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (preview.importableRows > 0) { %>
        <form method="POST" action="/player-load/import/confirm" class="d-flex gap-2 flex-wrap">
          <button type="submit" class="btn btn-primary">Confirmar importacion</button>
          <a href="/player-load/import?team_id=<%= selectedTeam ? selectedTeam.id : '' %>&season_id=<%= encodeURIComponent(selectedSeasonId) %>" class="btn btn-outline-secondary">Cancelar</a>
        </form>
      <% } %>
    </div>
  </div>
<% } %>
